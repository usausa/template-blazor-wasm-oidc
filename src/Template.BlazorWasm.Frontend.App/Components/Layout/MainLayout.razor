@inherits LayoutComponentBase

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentLayoutHamburger />
        <FluentText Weight="TextWeight.Bold" Size="TextSize.Size600">テンプレート</FluentText>
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Width="auto">
                    <FluentText>@context.User.Identity?.Name</FluentText>
                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="OnLogoutClick">ログアウト</FluentButton>
                </FluentStack>
            </Authorized>
        </AuthorizeView>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content">
        <ErrorBoundary>
            <ChildContent>
                <div class="content">
                    @Body
                </div>
            </ChildContent>
            <ErrorContent Context="_">
                <div class="blazor-error-boundary">予期せぬエラーが発生しました</div>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />
