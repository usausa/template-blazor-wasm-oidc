@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader>
        テンプレート
        <FluentSpacer />
        <AuthorizeView>
            <Authorized>
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" VerticalAlignment="VerticalAlignment.Center" Width="auto">
                    <FluentLabel>@context.User.Identity?.Name</FluentLabel>
                    <FluentButton Appearance="Appearance.Stealth" OnClick="OnLogoutClick">ログアウト</FluentButton>
                </FluentStack>
            </Authorized>
        </AuthorizeView>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <ErrorBoundary>
                <ChildContent>
                    <div class="content">
                        @Body
                    </div>
                </ChildContent>
                <ErrorContent Context="_">
                    <div class="blazor-error-boundary">予期せぬエラーが発生しました</div>
                </ErrorContent>
            </ErrorBoundary>
        </FluentBodyContent>
    </FluentStack>
    <FluentToastProvider />
    <FluentDialogProvider />
</FluentLayout>
