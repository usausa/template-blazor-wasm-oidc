<FluentDialogBody>
    <ChildContent>
        <EditForm EditContext="editContext">
            <DataAnnotationsValidator />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                <FluentTextInput @bind-Value="model.Name" Label="名前" MaxLength="@Length.Name" Width="100%" />
                <FluentNumberInput @bind-Value="model.Value" Label="値" Min="0" Max="999999999" Width="100%" />
                <ListItem Items="ModelMessages" Context="message">
                    <ItemTemplate>
                        <FluentText Color="Color.Error">@message</FluentText>
                    </ItemTemplate>
                </ListItem>
            </FluentStack>
        </EditForm>
    </ChildContent>

    <ActionTemplate>
        <FluentButton Appearance="ButtonAppearance.Primary" Loading="saving" OnClick="OnSaveClickAsync">保存</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" OnClick="OnCancelClickAsync">キャンセル</FluentButton>
    </ActionTemplate>
</FluentDialogBody>
